#!/usr/bin/env bash
# Run a command in the holder-cad container: no network, no published ports,
# no capabilities, read-only root fs. The repo is mounted at /work.
#   ./dock python -m holder     build all parts, run checks, export to out/
#   ./dock pytest -q            tests
#   ./dock ruff check .         lint
set -euo pipefail
cd "$(dirname "$0")"
exec docker run --rm -i --network none \
  --cap-drop ALL --security-opt no-new-privileges \
  --read-only --tmpfs /tmp:rw,exec,size=1g \
  -u "$(id -u):$(id -g)" \
  -v "$PWD":/work -w /work \
  holder-cad "$@"
